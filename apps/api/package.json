{
  "name": "@matilda/api",
  "version": "0.1.0",
  "private": true,
  "description": "Matilda Commerce backend API (NestJS modular monolith).",
  "scripts": {
    "dev": "nest start --watch",
    "build": "prisma generate && nest build",
    "start": "node dist/main.js",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "test": "prisma generate && jest && jest --config jest.e2e.config.cjs",
    "test:unit": "jest",
    "test:e2e": "jest --config jest.e2e.config.cjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:status": "prisma migrate status",
    "test:int": "jest --config jest.integration.config.cjs --runInBand",
    "db:seed": "node --env-file=.env dist/cli/seed.js",
    "db:create-super-admin": "node --env-file=.env dist/cli/create-super-admin.js",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@matilda/types": "workspace:*",
    "@matilda/validation": "workspace:*",
    "@nestjs/common": "^11.2.11",
    "@nestjs/core": "^11.2.11",
    "@nestjs/platform-express": "^11.2.11",
    "@nestjs/swagger": "^11.4.8",
    "@nestjs/throttler": "^6.8.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "^0.45.2",
    "bullmq": "^6.7.10",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "nestjs-cls": "^7.0.2",
    "nestjs-pino": "^5.3.2",
    "otplib": "^13.6.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@matilda/config": "workspace:*",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.11",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "pino-pretty": "^13.2.0",
    "prisma": "7.10.1",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15"
  }
}
