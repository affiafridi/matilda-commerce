# Copy to .env for local development. NEVER commit .env or real secrets.

NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=debug

# Comma-separated list of allowed browser origins (storefront, admin).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Swagger UI at /api/docs. Defaults to enabled outside production.
SWAGGER_ENABLED=true

# PostgreSQL: the Docker database from docker-compose.yml (host port 5434). Must match the root .env values.
DATABASE_URL=postgresql://matilda:matilda_dev_password@localhost:5434/matilda_dev?schema=public

# Redis (not required in Phase 1; reserved for caching/rate limiting/queues).
REDIS_URL=redis://localhost:6379
