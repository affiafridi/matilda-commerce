# Copy to .env for local development. NEVER commit .env or real secrets.

NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=debug

# Comma-separated list of allowed browser origins (storefront, admin).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Swagger UI at /api/docs. Defaults to enabled outside production.
SWAGGER_ENABLED=true
# Local development only: shows a switch on the sign-in page that skips two-factor. The API refuses to start with this on outside NODE_ENV=development.
DEV_SKIP_MFA=false

# --- PostgreSQL (Docker, host port 5434). Run `pnpm docker:up` first. ---
# Runtime role: DML only, subject to row-level security. Used by the running API.
DATABASE_URL=postgresql://matilda_app:matilda_app_dev_password@localhost:5434/matilda_dev?schema=public
# Owner role: runs Prisma migrations (DDL). Never used by the running API.
MIGRATION_DATABASE_URL=postgresql://matilda_owner:matilda_owner_dev_password@localhost:5434/matilda_dev?schema=public
# Integration tests use a separate database.
TEST_DATABASE_URL=postgresql://matilda_app:matilda_app_dev_password@localhost:5434/matilda_test?schema=public
TEST_MIGRATION_DATABASE_URL=postgresql://matilda_owner:matilda_owner_dev_password@localhost:5434/matilda_test?schema=public

# --- Secrets (generate your own; the values below are placeholders) ---
# Encryption key ring: "<version>:<base64 32-byte key>", comma-separated. Generate a key with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEYS=1:REPLACE_WITH_BASE64_32_BYTE_KEY
APP_ENCRYPTION_ACTIVE_KEY=1
# Shared secret the Next.js servers use when forwarding the real host header (min 32 chars):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TRUSTED_PROXY_SECRET=REPLACE_WITH_RANDOM_SECRET_OF_AT_LEAST_32_CHARS
# Pepper mixed into password hashes (>= 32 chars). Required in staging/production; set once before real accounts exist.
PASSWORD_PEPPER=REPLACE_WITH_RANDOM_SECRET_OF_AT_LEAST_32_CHARS
# Key that signs shopper quotes (>= 32 chars). Required in staging/production.
QUOTE_SIGNING_SECRET=REPLACE_WITH_RANDOM_SECRET_OF_AT_LEAST_32_CHARS
# Public URL of the admin app (used in invite and reset links)
ADMIN_BASE_URL=http://localhost:3001

# Redis (not required yet; reserved for caching/rate limiting/queues).
REDIS_URL=redis://localhost:6379

# --- Media (product images). Local disk in development; files are private and served through the API. ---
MEDIA_STORAGE=local
MEDIA_LOCAL_DIR=.media
# Largest accepted upload in bytes (default 10 MB).
MEDIA_MAX_UPLOAD_BYTES=10485760
