  reservationMinutes Int                @default(15) @map("reservation_minutes")
  maxExtensions      Int                @default(1) @map("max_extensions")
  defaultOutOfStock  OutOfStockBehavior @default(SHOW_UNAVAILABLE) @map("default_out_of_stock")
  brand              Brand              @relation("inventory_setting_33", fields: [brandId], references: [id], onDelete: Cascade)

  @@map("inventory_setting")
}

model StockLevel {
  id                 String                 @id @default(uuid(7)) @db.Uuid
  brandId            String                 @map("brand_id") @db.Uuid
  branchId           String                 @map("branch_id") @db.Uuid
  productId          String                 @map("product_id") @db.Uuid
  variationId        String?                @map("variation_id") @db.Uuid
  onHand             Int                    @default(0) @map("on_hand")
  reserved           Int                    @default(0)
  lowStockThreshold  Int                    @default(0) @map("low_stock_threshold")
  outOfStock         OutOfStockBehavior?    @map("out_of_stock")
  updatedAt          DateTime               @updatedAt @map("updated_at") @db.Timestamptz()
  branch             Branch                 @relation("stock_level_34", fields: [branchId], references: [id], onDelete: Restrict)
  product            Product                @relation("stock_level_35", fields: [productId, brandId], references: [id, brandId], onDelete: Restrict)
  variation          Variation?             @relation("stock_level_36", fields: [variationId, brandId], references: [id, brandId], onDelete: Restrict)
  variationByProduct Variation?             @relation("stock_level_37", fields: [variationId, productId], references: [id, productId], onDelete: Restrict)
  movements          StockMovement[]        @relation("stock_movement_38")
  reservationLines   StockReservationLine[] @relation("stock_reservation_line_42")

  @@unique([id, brandId])
  @@index([brandId, branchId])
  @@index([branchId])
  @@index([productId, brandId])
  @@index([variationId, brandId])
  @@index([variationId, productId])
  @@map("stock_level")
}

model StockMovement {
  id            String            @id @default(uuid(7)) @db.Uuid
  brandId       String            @map("brand_id") @db.Uuid
  stockLevelId  String            @map("stock_level_id") @db.Uuid
  type          StockMovementType
  quantity      Int
  onHandAfter   Int               @map("on_hand_after")
  reservedAfter Int               @map("reserved_after")
  reason        String?
  referenceType String?           @map("reference_type")
  referenceId   String?           @map("reference_id")
  transferId    String?           @map("transfer_id") @db.Uuid
  actorStaffId  String?           @map("actor_staff_id") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz()
  stockLevel    StockLevel        @relation("stock_movement_38", fields: [stockLevelId, brandId], references: [id, brandId], onDelete: Restrict)
  transfer      StockTransfer?    @relation("stock_movement_39", fields: [transferId, brandId], references: [id, brandId], onDelete: Restrict)

  @@index([stockLevelId, createdAt])
  @@index([stockLevelId, brandId])
  @@index([transferId, brandId])
  @@map("stock_movement")
}

model StockReservation {
  id            String                 @id @default(uuid(7)) @db.Uuid
  brandId       String                 @map("brand_id") @db.Uuid
  marketId      String                 @map("market_id") @db.Uuid
  status        ReservationStatus      @default(ACTIVE)
  checkoutRef   String                 @map("checkout_ref")
  expiresAt     DateTime               @map("expires_at") @db.Timestamptz()
  extendedCount Int                    @default(0) @map("extended_count")
  committedAt   DateTime?              @map("committed_at") @db.Timestamptz()
  releasedAt    DateTime?              @map("released_at") @db.Timestamptz()
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz()
  market        Market                 @relation("stock_reservation_40", fields: [marketId, brandId], references: [id, brandId], onDelete: Restrict)
  lines         StockReservationLine[] @relation("stock_reservation_line_41")

  @@unique([id, brandId])
  @@index([status, expiresAt])
  @@index([marketId, brandId])
  @@index([checkoutRef])
  @@map("stock_reservation")
}

model StockReservationLine {
  reservationId String           @map("reservation_id") @db.Uuid
  brandId       String           @map("brand_id") @db.Uuid
  stockLevelId  String           @map("stock_level_id") @db.Uuid
  quantity      Int
  reservation   StockReservation @relation("stock_reservation_line_41", fields: [reservationId, brandId], references: [id, brandId], onDelete: Cascade)
  stockLevel    StockLevel       @relation("stock_reservation_line_42", fields: [stockLevelId, brandId], references: [id, brandId], onDelete: Restrict)

  @@id([reservationId, stockLevelId])
  @@index([reservationId, brandId])
  @@index([stockLevelId, brandId])
  @@map("stock_reservation_line")
}

model SlotDay {
  brandId      String       @map("brand_id") @db.Uuid
  slotId       String       @map("slot_id") @db.Uuid
  deliveryDate DateTime     @map("delivery_date") @db.Date
  booked       Int          @default(0)
  slot         DeliverySlot @relation("slot_day_43", fields: [slotId, brandId], references: [id, brandId], onDelete: Cascade)

  @@id([slotId, deliveryDate])
  @@index([slotId, brandId])
  @@map("slot_day")
}

model SlotReservation {
  id           String            @id @default(uuid(7)) @db.Uuid
  brandId      String            @map("brand_id") @db.Uuid
  slotId       String            @map("slot_id") @db.Uuid
  deliveryDate DateTime          @map("delivery_date") @db.Date
  units        Int               @default(1)
  status       ReservationStatus @default(ACTIVE)
  checkoutRef  String            @map("checkout_ref")
  expiresAt    DateTime          @map("expires_at") @db.Timestamptz()
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz()
  slot         DeliverySlot      @relation("slot_reservation_44", fields: [slotId, brandId], references: [id, brandId], onDelete: Restrict)

  @@index([status, expiresAt])
  @@index([slotId, deliveryDate])
  @@index([slotId, brandId])
  @@index([checkoutRef])
  @@map("slot_reservation")
}

model StockTransfer {
  id            String              @id @default(uuid(7)) @db.Uuid
  brandId       String              @map("brand_id") @db.Uuid
  fromBranchId  String              @map("from_branch_id") @db.Uuid
  toBranchId    String              @map("to_branch_id") @db.Uuid
  status        TransferStatus      @default(REQUESTED)
  note          String?
  requestedById String?             @map("requested_by_id") @db.Uuid
  shippedAt     DateTime?           @map("shipped_at") @db.Timestamptz()
  receivedAt    DateTime?           @map("received_at") @db.Timestamptz()
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz()
  movements     StockMovement[]     @relation("stock_movement_39")
  brand         Brand               @relation("stock_transfer_45", fields: [brandId], references: [id], onDelete: Restrict)
  fromBranch    Branch              @relation("stock_transfer_46", fields: [fromBranchId], references: [id], onDelete: Restrict)
  toBranch      Branch              @relation("stock_transfer_47", fields: [toBranchId], references: [id], onDelete: Restrict)
  lines         StockTransferLine[] @relation("stock_transfer_line_48")

  @@unique([id, brandId])
  @@index([brandId, status])
  @@index([fromBranchId])
  @@index([toBranchId])
  @@map("stock_transfer")
}

model StockTransferLine {
  id                String        @id @default(uuid(7)) @db.Uuid
  transferId        String        @map("transfer_id") @db.Uuid
  brandId           String        @map("brand_id") @db.Uuid
  productId         String        @map("product_id") @db.Uuid
  variationId       String?       @map("variation_id") @db.Uuid
  quantityRequested Int           @map("quantity_requested")
  quantityShipped   Int?          @map("quantity_shipped")
  quantityReceived  Int?          @map("quantity_received")
  discrepancyNote   String?       @map("discrepancy_note")
  transfer          StockTransfer @relation("stock_transfer_line_48", fields: [transferId, brandId], references: [id, brandId], onDelete: Cascade)
  product           Product       @relation("stock_transfer_line_49", fields: [productId, brandId], references: [id, brandId], onDelete: Restrict)
  variation         Variation?    @relation("stock_transfer_line_50", fields: [variationId, brandId], references: [id, brandId], onDelete: Restrict)

  @@index([transferId, brandId])
  @@index([productId, brandId])
  @@index([variationId, brandId])
  @@map("stock_transfer_line")
}

// ---------------------------------------------------------------------------------------------
// Phase 5 (step 5.2, docs/PHASE-5-SCHEMA-DRAFT.md): carts, orders, payments, promotions.
// Check constraints, partial indexes, triggers and row-level security are hand-written SQL in
// the migration `commerce`.
// ---------------------------------------------------------------------------------------------

enum CartStatus {
  OPEN
  CONVERTED
  ABANDONED
  MERGED
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PENDING
  COD_PENDING
  PARTIALLY_PAID
  PAID
  FAILED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum FulfillmentStatus {
  UNASSIGNED
  ASSIGNED
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED_DELIVERY
  RETURNED
  PICKUP_READY
  PICKED_UP
}

enum PaymentAttemptStatus {
  INITIATED
  REDIRECTED
  SUCCEEDED
  FAILED
  EXPIRED
}

enum PaymentProvider {
  CCAVENUE
  COD
  MANUAL
}

enum PromotionKind {
  PERCENT_OFF
  FIXED_OFF
  FREE_DELIVERY
  FREE_GIFT
}

enum PromotionScope {
  ORDER
  PRODUCT
  CATEGORY
  COLLECTION
}

enum PromotionAudience {
  EVERYONE
  CUSTOMERS
  FIRST_ORDER
}

enum OrderLineKind {
  PRODUCT
  ADD_ON
  GIFT
}

model Cart {
  id               String         @id @default(uuid(7)) @db.Uuid
  brandId          String         @map("brand_id") @db.Uuid
  marketId         String         @map("market_id") @db.Uuid
  currencyCode     String         @map("currency_code") @db.Char(3)
  customerId       String?        @map("customer_id") @db.Uuid
  /// SHA-256 of the secret cookie value; the value itself is never stored.
  guestTokenHash   String?        @unique @map("guest_token_hash")
  status           CartStatus     @default(OPEN)
  /// Early delivery choices are hints; the order step validates everything again.
  deliveryAreaId   String?        @map("delivery_area_id") @db.Uuid
  deliveryDate     DateTime?      @map("delivery_date") @db.Date
  deliveryMethodId String?        @map("delivery_method_id") @db.Uuid
  slotId           String?        @map("slot_id") @db.Uuid
  couponCode       String?        @map("coupon_code")
  contactEmail     String?        @map("contact_email")
  contactPhone     String?        @map("contact_phone")
  lastActivityAt   DateTime       @default(now()) @map("last_activity_at") @db.Timestamptz()
  abandonedAt      DateTime?      @map("abandoned_at") @db.Timestamptz()
  convertedOrderId String?        @map("converted_order_id") @db.Uuid
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz()
  market           Market         @relation("c5_cart_market", fields: [marketId, brandId], references: [id, brandId], onDelete: Restrict)
  currency         MarketCurrency @relation("c5_cart_currency", fields: [marketId, currencyCode], references: [marketId, currencyCode], onDelete: Restrict)
  customer         Customer?      @relation("c5_cart_customer", fields: [customerId, brandId], references: [id, brandId], onDelete: Restrict)
  lines            CartLine[]     @relation("c5_cart_line_cart")

  @@unique([id, brandId])
  @@index([marketId, brandId])
  @@index([marketId, currencyCode])
  @@index([customerId, brandId])
  @@index([status, lastActivityAt])
  @@map("cart")
}

model CartLine {
  id          String                 @id @default(uuid(7)) @db.Uuid
  brandId     String                 @map("brand_id") @db.Uuid
  cartId      String                 @map("cart_id") @db.Uuid
  productId   String                 @map("product_id") @db.Uuid
  variationId String?                @map("variation_id") @db.Uuid
  quantity    Int
  note        String?
  createdAt   DateTime               @default(now()) @map("created_at") @db.Timestamptz()
  cart        Cart                   @relation("c5_cart_line_cart", fields: [cartId, brandId], references: [id, brandId], onDelete: Cascade)
  product     Product                @relation("c5_cart_line_product", fields: [productId, brandId], references: [id, brandId], onDelete: Restrict)
  variation   Variation?             @relation("c5_cart_line_variation", fields: [variationId, brandId], references: [id, brandId], onDelete: Restrict)
  options     CartLineOption[]       @relation("c5_cart_line_option_line")
  addOns      CartLineAddon[]        @relation("c5_cart_line_addon_line")
  bundles     CartLineBundleChoice[] @relation("c5_cart_line_bundle_line")

  @@unique([id, brandId])
  @@index([cartId, brandId])
  @@index([productId, brandId])
  @@index([variationId, brandId])
  @@map("cart_line")
}

model CartLineOption {
  id            String        @id @default(uuid(7)) @db.Uuid
  brandId       String        @map("brand_id") @db.Uuid
  lineId        String        @map("line_id") @db.Uuid
  optionGroupId String        @map("option_group_id") @db.Uuid
  choiceId      String?       @map("choice_id") @db.Uuid
  text          String?
  line          CartLine      @relation("c5_cart_line_option_line", fields: [lineId, brandId], references: [id, brandId], onDelete: Cascade)
  optionGroup   OptionGroup   @relation("c5_cart_line_option_group", fields: [optionGroupId, brandId], references: [id, brandId], onDelete: Restrict)
  choice        OptionChoice? @relation("c5_cart_line_option_choice", fields: [choiceId, brandId], references: [id, brandId], onDelete: Restrict)

  @@index([lineId, brandId])
  @@index([optionGroupId, brandId])
  @@index([choiceId, brandId])
  @@map("cart_line_option")
}

model CartLineAddon {
  lineId      String    @map("line_id") @db.Uuid
  brandId     String    @map("brand_id") @db.Uuid
  addonItemId String    @map("addon_item_id") @db.Uuid
  quantity    Int
  line        CartLine  @relation("c5_cart_line_addon_line", fields: [lineId, brandId], references: [id, brandId], onDelete: Cascade)
  addonItem   AddonItem @relation("c5_cart_line_addon_item", fields: [addonItemId, brandId], references: [id, brandId], onDelete: Restrict)

  @@id([lineId, addonItemId])
  @@index([lineId, brandId])
  @@index([addonItemId, brandId])
  @@map("cart_line_addon")
}

model CartLineBundleChoice {
  lineId       String     @map("line_id") @db.Uuid
  brandId      String     @map("brand_id") @db.Uuid
  bundleItemId String     @map("bundle_item_id") @db.Uuid
  variationId  String?    @map("variation_id") @db.Uuid
  line         CartLine   @relation("c5_cart_line_bundle_line", fields: [lineId, brandId], references: [id, brandId], onDelete: Cascade)
  bundleItem   BundleItem @relation("c5_cart_line_bundle_item", fields: [bundleItemId, brandId], references: [id, brandId], onDelete: Restrict)
  variation    Variation? @relation("c5_cart_line_bundle_variation", fields: [variationId, brandId], references: [id, brandId], onDelete: Restrict)

  @@id([lineId, bundleItemId])
  @@index([lineId, brandId])
  @@index([bundleItemId, brandId])
  @@index([variationId, brandId])
  @@map("cart_line_bundle_choice")
}

model CustomerOrder {
  id                   String               @id @default(uuid(7)) @db.Uuid
  brandId              String               @map("brand_id") @db.Uuid
  marketId             String               @map("market_id") @db.Uuid
  number               String
  status               OrderStatus          @default(DRAFT)
  paymentStatus        PaymentStatus        @default(UNPAID) @map("payment_status")
  fulfillmentStatus    FulfillmentStatus    @default(UNASSIGNED) @map("fulfillment_status")
  customerId           String?              @map("customer_id") @db.Uuid
  guestEmail           String?              @map("guest_email")
  guestPhone           String?              @map("guest_phone")
  currencyCode         String               @map("currency_code") @db.Char(3)
  subtotalMinor        Int                  @map("subtotal_minor")
  discountMinor        Int                  @map("discount_minor")
  deliveryFeeMinor     Int                  @map("delivery_fee_minor")
  taxMinor             Int                  @map("tax_minor")
  totalMinor           Int                  @map("total_minor")
  taxInclusive         Boolean              @map("tax_inclusive")
  contactName          String               @map("contact_name")
  contactEmail         String               @map("contact_email")
  contactPhone         String               @map("contact_phone")
  recipientName        String               @map("recipient_name")
  recipientPhone       String               @map("recipient_phone")
  deliveryAddress      Json                 @map("delivery_address")
  billingAddress       Json?                @map("billing_address")
  deliveryAreaId       String?              @map("delivery_area_id") @db.Uuid
  zoneId               String?              @map("zone_id") @db.Uuid
  deliveryMethodId     String?              @map("delivery_method_id") @db.Uuid
  deliveryMethodKind   DeliveryMethodKind?  @map("delivery_method_kind")
  deliveryDate         DateTime?            @map("delivery_date") @db.Date
  slotId               String?              @map("slot_id") @db.Uuid
  slotStart            DateTime?            @map("slot_start") @db.Time()
  slotEnd              DateTime?            @map("slot_end") @db.Time()
  branchId             String?              @map("branch_id") @db.Uuid
  giftMessage          String?              @map("gift_message")
  anonymousGift        Boolean              @default(false) @map("anonymous_gift")
  instructions         String?
  paymentConfigVersion Int?                 @map("payment_config_version")
  paymentProvider      PaymentProvider?     @map("payment_provider")
  paymentMethod        String?              @map("payment_method")
  idempotencyKey       String               @map("idempotency_key")
  couponCode           String?              @map("coupon_code")
  placedAt             DateTime             @default(now()) @map("placed_at") @db.Timestamptz()
  confirmedAt          DateTime?            @map("confirmed_at") @db.Timestamptz()
  cancelledAt          DateTime?            @map("cancelled_at") @db.Timestamptz()
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt            DateTime             @updatedAt @map("updated_at") @db.Timestamptz()
  market               Market               @relation("c5_order_market", fields: [marketId, brandId], references: [id, brandId], onDelete: Restrict)
  currency             MarketCurrency       @relation("c5_order_currency", fields: [marketId, currencyCode], references: [marketId, currencyCode], onDelete: Restrict)
  customer             Customer?            @relation("c5_order_customer", fields: [customerId, brandId], references: [id, brandId], onDelete: Restrict)
  lines                OrderLine[]          @relation("c5_order_line_order")
  promotions           OrderPromotion[]     @relation("c5_order_promotion_order")
  history              OrderStatusHistory[] @relation("c5_order_history_order")
  payment              Payment?             @relation("c5_payment_order")
  usages               PromotionUsage[]     @relation("c5_usage_order")

  @@unique([id, brandId])
  @@unique([brandId, number])
  @@unique([brandId, idempotencyKey])
  @@index([marketId, brandId])
  @@index([marketId, currencyCode])
  @@index([customerId, brandId, createdAt])
  @@index([brandId, status, createdAt])
  @@index([branchId, deliveryDate])
  @@map("customer_order")
}

model OrderLine {
  id            String        @id @default(uuid(7)) @db.Uuid
  brandId       String        @map("brand_id") @db.Uuid
  orderId       String        @map("order_id") @db.Uuid
  position      Int
  kind          OrderLineKind
  /// Kept for reports only; deliberately no foreign key, so catalog deletes never touch history.
  productId     String?       @map("product_id") @db.Uuid
  variationId   String?       @map("variation_id") @db.Uuid
  name          Json
  sku           String?
  options       Json          @default("[]")
  addOns        Json          @default("[]") @map("add_ons")
  bundleItems   Json          @default("[]") @map("bundle_items")
  quantity      Int
  unitMinor     Int           @map("unit_minor")
  discountMinor Int           @map("discount_minor")
  taxMinor      Int           @map("tax_minor")
  totalMinor    Int           @map("total_minor")
  order         CustomerOrder @relation("c5_order_line_order", fields: [orderId, brandId], references: [id, brandId], onDelete: Restrict)

  @@unique([orderId, position])
  @@index([orderId, brandId])
  @@map("order_line")
}

model OrderPromotion {
  id          String        @id @default(uuid(7)) @db.Uuid
  brandId     String        @map("brand_id") @db.Uuid
  orderId     String        @map("order_id") @db.Uuid
  promotionId String?       @map("promotion_id") @db.Uuid
  couponCode  String?       @map("coupon_code")
  name        Json
  kind        PromotionKind
  amountMinor Int           @map("amount_minor")
  order       CustomerOrder @relation("c5_order_promotion_order", fields: [orderId, brandId], references: [id, brandId], onDelete: Restrict)

  @@index([orderId, brandId])
  @@map("order_promotion")
}

model OrderStatusHistory {
  id              String        @id @default(uuid(7)) @db.Uuid
  brandId         String        @map("brand_id") @db.Uuid
  orderId         String        @map("order_id") @db.Uuid
  /// ORDER, PAYMENT or FULFILLMENT.
  dimension       String
  fromStatus      String?       @map("from_status")
  toStatus        String        @map("to_status")
  actorStaffId    String?       @map("actor_staff_id") @db.Uuid
  actorCustomerId String?       @map("actor_customer_id") @db.Uuid
  reason          String?
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  order           CustomerOrder @relation("c5_order_history_order", fields: [orderId, brandId], references: [id, brandId], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@index([orderId, brandId])
  @@map("order_status_history")
}

model OrderCounter {
  brandId   String @id @map("brand_id") @db.Uuid
  prefix    String
  nextValue Int    @default(100000) @map("next_value")
  brand     Brand  @relation("c5_order_counter_brand", fields: [brandId], references: [id], onDelete: Restrict)

  @@map("order_counter")
}

model PaymentConfig {
  id                   String          @id @default(uuid(7)) @db.Uuid
  brandId              String          @map("brand_id") @db.Uuid
  marketId             String          @map("market_id") @db.Uuid
  provider             PaymentProvider
  version              Int
  status               ActiveStatus    @default(ACTIVE)
  displayName          Json            @map("display_name")
  enabledMethods       String[]        @map("enabled_methods")
  /// EncryptionService envelope (AES-256-GCM, key ring). Null for COD and MANUAL. Never returned by any API.
  credentialsEncrypted String?         @map("credentials_encrypted")
  credentialsLast4     String?         @map("credentials_last4")
  testMode             Boolean         @default(true) @map("test_mode")
  codZoneIds           String[]        @map("cod_zone_ids")
  codMaxOrderMinor     Int?            @map("cod_max_order_minor")
  createdById          String?         @map("created_by_id") @db.Uuid
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz()
  market               Market          @relation("c5_payment_config_market", fields: [marketId, brandId], references: [id, brandId], onDelete: Restrict)
  payments             Payment[]       @relation("c5_payment_config")

  @@unique([id, brandId])
  @@unique([brandId, marketId, provider, version])
  @@index([marketId, brandId])
  @@map("payment_config")
}

model Payment {
  id            String           @id @default(uuid(7)) @db.Uuid
  brandId       String           @map("brand_id") @db.Uuid
  orderId       String           @unique @map("order_id") @db.Uuid
  provider      PaymentProvider
  configId      String           @map("config_id") @db.Uuid
  configVersion Int              @map("config_version")
  currencyCode  String           @map("currency_code") @db.Char(3)
  amountMinor   Int              @map("amount_minor")
  paidMinor     Int              @default(0) @map("paid_minor")
  refundedMinor Int              @default(0) @map("refunded_minor")
  status        PaymentStatus    @default(UNPAID)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz()
  order         CustomerOrder    @relation("c5_payment_order", fields: [orderId, brandId], references: [id, brandId], onDelete: Restrict)
  config        PaymentConfig    @relation("c5_payment_config", fields: [configId, brandId], references: [id, brandId], onDelete: Restrict)
  attempts      PaymentAttempt[] @relation("c5_attempt_payment")
  events        PaymentEvent[]   @relation("c5_event_payment")

  @@unique([id, brandId])
  @@unique([orderId, brandId])
  @@index([configId, brandId])
  @@map("payment")
}

model PaymentAttempt {
  id                String               @id @default(uuid(7)) @db.Uuid
  brandId           String               @map("brand_id") @db.Uuid
  paymentId         String               @map("payment_id") @db.Uuid
  reference         String
  status            PaymentAttemptStatus @default(INITIATED)
  amountMinor       Int                  @map("amount_minor")
  currencyCode      String               @map("currency_code") @db.Char(3)
  providerReference String?              @map("provider_reference")
  /// Allow-listed fields only; never card data.
  requestSummary    Json                 @default("{}") @map("request_summary")
  verifiedSummary   Json?                @map("verified_summary")
  idempotencyKey    String               @map("idempotency_key")
  expiresAt         DateTime             @map("expires_at") @db.Timestamptz()
  verifiedAt        DateTime?            @map("verified_at") @db.Timestamptz()
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz()
  payment           Payment              @relation("c5_attempt_payment", fields: [paymentId, brandId], references: [id, brandId], onDelete: Restrict)

  @@unique([brandId, reference])
  @@unique([brandId, idempotencyKey])
  @@index([paymentId, brandId])
  @@index([status, expiresAt])
  @@map("payment_attempt")
}

model PaymentEvent {
  id         String          @id @default(uuid(7)) @db.Uuid
  brandId    String          @map("brand_id") @db.Uuid
  paymentId  String?         @map("payment_id") @db.Uuid
  provider   PaymentProvider
  /// The provider's own event or tracking id; the unique key makes a repeated callback a no-op.
  eventKey   String          @map("event_key")
  kind       String
  accepted   Boolean
  summary    Json            @default("{}")
  receivedAt DateTime        @default(now()) @map("received_at") @db.Timestamptz()
  payment    Payment?        @relation("c5_event_payment", fields: [paymentId, brandId], references: [id, brandId], onDelete: Restrict)

  @@unique([brandId, provider, eventKey])
  @@index([paymentId, brandId])
  @@map("payment_event")
}

model Promotion {
  id               String                 @id @default(uuid(7)) @db.Uuid
  brandId          String                 @map("brand_id") @db.Uuid
  code             String
  kind             PromotionKind
  scope            PromotionScope         @default(ORDER)
  percentBps       Int?                   @map("percent_bps")
  fixedMinor       Int?                   @map("fixed_minor")
  currencyCode     String?                @map("currency_code") @db.Char(3)
  giftProductId    String?                @map("gift_product_id") @db.Uuid
  giftVariationId  String?                @map("gift_variation_id") @db.Uuid
  maxDiscountMinor Int?                   @map("max_discount_minor")
  minSubtotalMinor Int                    @default(0) @map("min_subtotal_minor")
  audience         PromotionAudience      @default(EVERYONE)
  priority         Int                    @default(100)
  combinable       Boolean                @default(false)
  startsAt         DateTime?              @map("starts_at") @db.Timestamptz()
  endsAt           DateTime?              @map("ends_at") @db.Timestamptz()
  usageLimit       Int?                   @map("usage_limit")
  perCustomerLimit Int?                   @map("per_customer_limit")
  usedCount        Int                    @default(0) @map("used_count")
  requiresCoupon   Boolean                @default(false) @map("requires_coupon")
  status           ActiveStatus           @default(ACTIVE)
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.Timestamptz()
  currency         Currency?              @relation("c5_promotion_currency", fields: [currencyCode], references: [code], onDelete: Restrict)
  giftProduct      Product?               @relation("c5_promotion_gift_product", fields: [giftProductId, brandId], references: [id, brandId], onDelete: Restrict)
  giftVariation    Variation?             @relation("c5_promotion_gift_variation", fields: [giftVariationId, brandId], references: [id, brandId], onDelete: Restrict)
  translations     PromotionTranslation[] @relation("c5_promotion_translation")
  markets          PromotionMarket[]      @relation("c5_promotion_market_promotion")
  targets          PromotionTarget[]      @relation("c5_promotion_target_promotion")
  coupons          Coupon[]               @relation("c5_coupon_promotion")
  usages           PromotionUsage[]       @relation("c5_usage_promotion")

  @@unique([id, brandId])
  @@unique([brandId, code])
  @@index([brandId, status, priority])
  @@index([giftProductId, brandId])
  @@index([giftVariationId, brandId])
  @@index([currencyCode])
  @@map("promotion")
}

model PromotionTranslation {
  promotionId String    @map("promotion_id") @db.Uuid
  brandId     String    @map("brand_id") @db.Uuid
  language    String
  name        String
  description String?
  promotion   Promotion @relation("c5_promotion_translation", fields: [promotionId, brandId], references: [id, brandId], onDelete: Cascade)

  @@id([promotionId, language])
  @@index([promotionId, brandId])
  @@map("promotion_translation")
}

model PromotionMarket {
  promotionId String    @map("promotion_id") @db.Uuid
  brandId     String    @map("brand_id") @db.Uuid
  marketId    String    @map("market_id") @db.Uuid
  promotion   Promotion @relation("c5_promotion_market_promotion", fields: [promotionId, brandId], references: [id, brandId], onDelete: Cascade)
  market      Market    @relation("c5_promotion_market_market", fields: [marketId, brandId], references: [id, brandId], onDelete: Cascade)

  @@id([promotionId, marketId])
  @@index([promotionId, brandId])
  @@index([marketId, brandId])
  @@map("promotion_market")
}

model PromotionTarget {
  id           String      @id @default(uuid(7)) @db.Uuid
  brandId      String      @map("brand_id") @db.Uuid
  promotionId  String      @map("promotion_id") @db.Uuid
  productId    String?     @map("product_id") @db.Uuid
  categoryId   String?     @map("category_id") @db.Uuid
  collectionId String?     @map("collection_id") @db.Uuid
  promotion    Promotion   @relation("c5_promotion_target_promotion", fields: [promotionId, brandId], references: [id, brandId], onDelete: Cascade)
  product      Product?    @relation("c5_promotion_target_product", fields: [productId, brandId], references: [id, brandId], onDelete: Cascade)
  category     Category?   @relation("c5_promotion_target_category", fields: [categoryId, brandId], references: [id, brandId], onDelete: Cascade)
  collection   Collection? @relation("c5_promotion_target_collection", fields: [collectionId, brandId], references: [id, brandId], onDelete: Cascade)

  @@index([promotionId, brandId])
  @@index([productId, brandId])
  @@index([categoryId, brandId])
  @@index([collectionId, brandId])
  @@map("promotion_target")
}

model Coupon {
  id          String           @id @default(uuid(7)) @db.Uuid
  brandId     String           @map("brand_id") @db.Uuid
  promotionId String           @map("promotion_id") @db.Uuid
  /// Stored upper-case, unique per brand.
  code        String
  usageLimit  Int?             @map("usage_limit")
  usedCount   Int              @default(0) @map("used_count")
  status      ActiveStatus     @default(ACTIVE)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  promotion   Promotion        @relation("c5_coupon_promotion", fields: [promotionId, brandId], references: [id, brandId], onDelete: Restrict)
  usages      PromotionUsage[] @relation("c5_usage_coupon")

  @@unique([id, brandId])
  @@unique([brandId, code])
  @@index([promotionId, brandId])
  @@map("coupon")
}

model PromotionUsage {
  id          String        @id @default(uuid(7)) @db.Uuid
  brandId     String        @map("brand_id") @db.Uuid
  promotionId String        @map("promotion_id") @db.Uuid
  couponId    String?       @map("coupon_id") @db.Uuid
  orderId     String        @map("order_id") @db.Uuid
  customerId  String?       @map("customer_id") @db.Uuid
  amountMinor Int           @map("amount_minor")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  promotion   Promotion     @relation("c5_usage_promotion", fields: [promotionId, brandId], references: [id, brandId], onDelete: Restrict)
  coupon      Coupon?       @relation("c5_usage_coupon", fields: [couponId, brandId], references: [id, brandId], onDelete: Restrict)
  order       CustomerOrder @relation("c5_usage_order", fields: [orderId, brandId], references: [id, brandId], onDelete: Restrict)

  @@unique([orderId, promotionId])
  @@index([promotionId, brandId])
  @@index([couponId, brandId])
  @@index([orderId, brandId])
  @@index([customerId])
  @@map("promotion_usage")
}

model CustomerAddress {
  id            String       @id @default(uuid(7)) @db.Uuid
  brandId       String       @map("brand_id") @db.Uuid
  customerId    String       @map("customer_id") @db.Uuid
  label         String?
  recipientName String       @map("recipient_name")
  phone         String
  line1         String
  line2         String?
  areaId        String       @map("area_id") @db.Uuid
  city          String?
  notes         String?
  isDefault     Boolean      @default(false) @map("is_default")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz()
  customer      Customer     @relation("c5_address_customer", fields: [customerId, brandId], references: [id, brandId], onDelete: Cascade)
  area          DeliveryArea @relation("c5_address_area", fields: [areaId], references: [id], onDelete: Restrict)

  @@unique([id, brandId])
  @@index([customerId, brandId])
  @@index([areaId])
  @@map("customer_address")
}
