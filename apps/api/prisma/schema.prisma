  addonProduct                 Product?               @relation("addon_item_1", fields: [addonProductId, brandId], references: [id, brandId], onDelete: Restrict)
  addonVariation               Variation?             @relation("addon_item_2", fields: [addonVariationId, brandId], references: [id, brandId], onDelete: Restrict)
  addonVariationByAddonProduct Variation?             @relation("addon_item_3", fields: [addonVariationId, addonProductId], references: [id, productId], onDelete: Restrict)
  translations                 AddonItemTranslation[] @relation("addon_item_translation_0")
  prices                       AddonItemPrice[]       @relation("addon_item_price_0")

  @@unique([id, brandId])
  @@index([addonGroupId])
  @@index([addonProductId])
  @@index([addonVariationId, addonProductId])
  @@index([addonGroupId, brandId])
  @@index([addonProductId, brandId])
  @@index([addonVariationId, brandId])
  @@map("addon_item")
}

model AddonGroupTranslation {
  brandId      String     @map("brand_id") @db.Uuid
  addonGroupId String     @map("addon_group_id") @db.Uuid
  language     String
  label        String
  addonGroup   AddonGroup @relation("addon_group_translation_0", fields: [addonGroupId, brandId], references: [id, brandId], onDelete: Cascade)

  @@id([addonGroupId, language])
  @@index([addonGroupId, brandId])
  @@map("addon_group_translation")
}

model AddonItemTranslation {
  brandId     String    @map("brand_id") @db.Uuid
  addonItemId String    @map("addon_item_id") @db.Uuid
  language    String
  label       String
  addonItem   AddonItem @relation("addon_item_translation_0", fields: [addonItemId, brandId], references: [id, brandId], onDelete: Cascade)

  @@id([addonItemId, language])
  @@index([addonItemId, brandId])
  @@map("addon_item_translation")
}

model AddonItemPrice {
  id                   String         @id @default(uuid(7)) @db.Uuid
  brandId              String         @map("brand_id") @db.Uuid
  addonItemId          String         @map("addon_item_id") @db.Uuid
  marketId             String         @map("market_id") @db.Uuid
  currencyCode         String         @map("currency_code") @db.Char(3)
  deltaMinor           Int            @map("delta_minor")
  addonItem            AddonItem      @relation("addon_item_price_0", fields: [addonItemId, brandId], references: [id, brandId], onDelete: Cascade)
  market               Market         @relation("addon_item_price_1", fields: [marketId, brandId], references: [id, brandId], onDelete: Restrict)
  marketByCurrencyCode MarketCurrency @relation("addon_item_price_2", fields: [marketId, currencyCode], references: [marketId, currencyCode], onDelete: Restrict)

  @@unique([addonItemId, marketId, currencyCode])
  @@index([marketId, currencyCode])
  @@index([addonItemId, brandId])
  @@index([marketId, brandId])
  @@map("addon_item_price")
}

model BundleItem {
  id                                   String     @id @default(uuid(7)) @db.Uuid
  brandId                              String     @map("brand_id") @db.Uuid
  bundleProductId                      String     @map("bundle_product_id") @db.Uuid
  componentProductId                   String     @map("component_product_id") @db.Uuid
  componentVariationId                 String?    @map("component_variation_id") @db.Uuid
  quantity                             Int        @default(1)
  sortOrder                            Int        @default(0) @map("sort_order")
  bundleProduct                        Product    @relation("bundle_item_0", fields: [bundleProductId, brandId], references: [id, brandId], onDelete: Cascade)
  componentProduct                     Product    @relation("bundle_item_1", fields: [componentProductId, brandId], references: [id, brandId], onDelete: Restrict)
  componentVariation                   Variation? @relation("bundle_item_2", fields: [componentVariationId, brandId], references: [id, brandId], onDelete: Restrict)
  componentVariationByComponentProduct Variation? @relation("bundle_item_3", fields: [componentVariationId, componentProductId], references: [id, productId], onDelete: Restrict)

  @@index([bundleProductId])
  @@index([componentProductId])
  @@index([componentVariationId, componentProductId])
  @@index([bundleProductId, brandId])
  @@index([componentProductId, brandId])
  @@index([componentVariationId, brandId])
  @@map("bundle_item")
}

model MediaAsset {
  id                         String                  @id @default(uuid(7)) @db.Uuid
  brandId                    String                  @map("brand_id") @db.Uuid
  storageKey                 String                  @map("storage_key")
  originalFilename           String                  @map("original_filename")
  contentType                String                  @map("content_type")
  byteSize                   Int                     @map("byte_size")
  width                      Int?
  height                     Int?
  sha256                     String
  status                     MediaStatus             @default(UPLOADED)
  createdById                String?                 @map("created_by_id") @db.Uuid
  createdAt                  DateTime                @default(now()) @map("created_at") @db.Timestamptz()
  ProductMediaMediaAssetRel1 ProductMedia[]          @relation("product_media_1")
  CategoryMediaAssetRel2     Category[]              @relation("category_2")
  VariationMediaAssetRel1    Variation[]             @relation("variation_1")
  brand                      Brand                   @relation("media_asset_0", fields: [brandId], references: [id], onDelete: Restrict)
  translations               MediaAssetTranslation[] @relation("media_asset_translation_0")
  variants                   MediaVariant[]          @relation("media_variant_0")

  @@unique([id, brandId])
  @@unique([brandId, sha256])
  @@unique([storageKey])
  @@map("media_asset")
}

model MediaAssetTranslation {
  brandId      String     @map("brand_id") @db.Uuid
  mediaAssetId String     @map("media_asset_id") @db.Uuid
  language     String
  altText      String     @map("alt_text")
  mediaAsset   MediaAsset @relation("media_asset_translation_0", fields: [mediaAssetId, brandId], references: [id, brandId], onDelete: Cascade)

  @@id([mediaAssetId, language])
  @@index([mediaAssetId, brandId])
  @@map("media_asset_translation")
}

model MediaVariant {
  brandId      String     @map("brand_id") @db.Uuid
  mediaAssetId String     @map("media_asset_id") @db.Uuid
  kind         String
  storageKey   String     @map("storage_key")
  width        Int
  height       Int
  contentType  String     @map("content_type")
  mediaAsset   MediaAsset @relation("media_variant_0", fields: [mediaAssetId, brandId], references: [id, brandId], onDelete: Cascade)

  @@id([mediaAssetId, kind])
  @@unique([storageKey])
  @@index([mediaAssetId, brandId])
  @@map("media_variant")
}

model CatalogSlugHistory {
  id         String   @id @default(uuid(7)) @db.Uuid
  brandId    String   @map("brand_id") @db.Uuid
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  language   String
  slug       String
  retiredAt  DateTime @default(now()) @map("retired_at") @db.Timestamptz()
  brand      Brand    @relation("catalog_slug_history_0", fields: [brandId], references: [id], onDelete: Restrict)

  @@unique([brandId, entityType, language, slug])
  @@index([entityType, entityId])
  @@map("catalog_slug_history")
}
