# Copy to .env.local for local development. NEVER commit .env.local or real secrets.
# Base URL of the backend API, including the global prefix and version.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Server-side address of the API. Next.js proxies /api/* here so the browser stays on one origin.
API_INTERNAL_URL=http://localhost:4000
